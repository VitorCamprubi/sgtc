# =============================================================
# SGTC - exemplo de variaveis de ambiente
# Copie para .env e ajuste:    cp .env.example .env
# =============================================================

# --- Perfil Spring ---
# Em DEV deixe vazio (perfil default).
# Em PROD use:  SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=

# --- MySQL ---
MYSQL_DATABASE=sgtc
MYSQL_USER=sgtc
MYSQL_PASSWORD=troque_em_producao
MYSQL_ROOT_PASSWORD=troque_em_producao
MYSQL_PORT=3307

# --- JWT ---
# Gere com: openssl rand -base64 64
# Em prod, NAO use o valor de dev "sgtc-dev-jwt-secret-key-32-bytes-minimum".
JWT_SECRET=troque_para_um_valor_aleatorio_de_pelo_menos_32_bytes
JWT_EXPIRATION_MINUTES=60

# --- CORS ---
# Em prod, aponte para o dominio publico do front.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- E-mail / SMTP ---
# Para Gmail: ative 2FA e gere uma App Password em https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@sgtc.local
MAIL_FROM_NAME=SGTC - Sistema de Gerenciamento de Trabalhos Cientificos
# false para nao enviar email em DEV (so loga).
MAIL_ENABLED=false

# --- URLs publicas (usadas nos links dos e-mails) ---
APP_API_URL=http://localhost:8080
APP_WEB_URL=http://localhost:4200

# --- JVM ---
# Ex.: -Xms256m -Xmx512m
JAVA_OPTS=

# --- Reverse proxy / TLS (Caddy) ---
# Em PROD: dominio publico. Caddy gera certificado Let's Encrypt automaticamente.
# Ex.: SGTC_DOMAIN=sgtc.fatectatui.edu.br
# Em DEV: deixe vazio (Caddy escuta em http://localhost).
SGTC_DOMAIN=
